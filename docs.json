{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Sequencer Knowledge Docs: FedRAMP 20x, CR26, and Community Discussions, Updated Nightly",
  "description": "Plain-English summaries of the FedRAMP Consolidated Rules for 2026 and what FedRAMP staff say about them, from Sequencer Assurance.",
  "colors": {
    "primary": "#c1272d",
    "light": "#c2b499",
    "dark": "#c1272d"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    }
  },
  "logo": {
    "light": "/brand/sequencer-lockup-horizontal-black.svg",
    "dark": "/brand/sequencer-lockup-horizontal-white.svg"
  },
  "favicon": "/brand/sequencer-symbol-red.svg",
  "fonts": {
    "body": {
      "family": "Geist"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": ["index", "changelog"]
      },
      {
        "group": "Rule summaries",
        "pages": [
          "rules/index",
          "rules/provider-deliverables",
          "rules/frr-and-ksi",
          {
            "group": "Certification and packages",
            "pages": [
              "rules/fedramp-certification",
              "rules/certification-package-overview",
              "rules/security-decision-record",
              "rules/minimum-assessment-scope",
              "rules/certification-data-sharing",
              "rules/marketplace-listing"
            ]
          },
          {
            "group": "Ongoing operations",
            "pages": [
              "rules/vulnerability-detection-and-response",
              "rules/vulnerability-evaluation-and-reporting",
              "rules/significant-change-notification",
              "rules/incident-evaluation-and-communication",
              "rules/collaborative-continuous-monitoring",
              "rules/addressing-fedramp-communication"
            ]
          },
          {
            "group": "Security practices",
            "pages": [
              "rules/key-security-indicators",
              "rules/secure-configuration-guide",
              "rules/cryptographic-module-use"
            ]
          },
          {
            "group": "Assessors and agencies",
            "pages": [
              "rules/independent-verification-and-validation",
              "rules/fedramp-recognition",
              "rules/agency-use"
            ]
          }
        ]
      },
      {
        "group": "Discussion digests",
        "pages": [
          "discussions/index",
          "discussions/rev5-cr26-questions",
          "discussions/20x-cr26-questions",
          "discussions/notable-staff-answers",
          "discussions/rfc-history"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Official FedRAMP rules",
          "href": "https://www.fedramp.gov/2026/",
          "icon": "landmark"
        },
        {
          "anchor": "FedRAMP community discussions",
          "href": "https://github.com/FedRAMP/community/discussions",
          "icon": "comments"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "FedRAMP Help",
        "href": "https://help.fedramp.gov"
      },
      {
        "label": "Sequencer Assurance",
        "href": "https://sequencerassurance.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Book a call",
      "href": "https://calendly.com/jack-sequencerassurance/30min"
    }
  },
  "footer": {
    "socials": {
      "website": "https://sequencerassurance.com",
      "linkedin": "https://www.linkedin.com/in/jack-rumsey-83303469/"
    },
    "links": [
      {
        "header": "Sequencer Assurance",
        "items": [
          { "label": "Website", "href": "https://sequencerassurance.com" },
          { "label": "Book a call", "href": "https://calendly.com/jack-sequencerassurance/30min" }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "seo": {
    "metatags": {
      "canonical": "https://sequencerassurance.com/docs"
    }
  }
